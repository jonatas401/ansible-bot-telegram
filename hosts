all:
  hosts:
    10.0.0.1: # ip public de uma máquina  virtual ou se preferir user o  localhost
  vars:
    ansible_ssh_user: 'root' 
    ansible_ssh_private_key_file: "/home/root/ansible/key.pem" #caminho para sua chave de acesso ssh 
    telegram_bot_token: "token do bot do telegram"
    chat_id: "id do seu chat"
    message_text: "Mensagem enviada via Ansible em {{ ansible_date_time.date }} às {{ ansible_date_time.time }}."

